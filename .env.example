# Copy this file to .env.local and fill in the values.

# Database (required)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/database?sslmode=require"

# Google OAuth — required for login
# Generate AUTH_SECRET with: openssl rand -base64 32
# Get Google credentials at: console.cloud.google.com → APIs & Services → Credentials
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Required when the app is not served from localhost.
AUTH_URL=""
AUTH_TRUST_HOST="true"

# Daily job
# The scheduler runs in-app at 13:00 UTC; this secret protects the manual
# trigger at GET /api/cron/daily.
CRON_SECRET=""
# Set to 1 to stop the in-app scheduler (useful in local dev).
DISABLE_INAPP_CRON=""

# Cloudflare R2 — required to attach files to invoices
# Uploads and downloads go through presigned URLs; the app never proxies bytes.
R2_ACCOUNT_ID=""
R2_BUCKET_NAME=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Optional — defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# Point it at http://localhost:9000 to use the MinIO in docker-compose.yml.
R2_ENDPOINT=""

# Web Push (VAPID) — required for push notifications
# Generate with: pnpm dlx web-push generate-vapid-keys --json
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
