# Copy this file to .env and fill in the values

# Database (required)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/database?sslmode=require"

# Vercel Cron secret (optional)
CRON_SECRET=""

# Google OAuth — required for login
# Generate AUTH_SECRET with: openssl rand -base64 32
# Get Google credentials at: console.cloud.google.com → APIs & Services → Credentials
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Gmail — required for email notifications
# Generate an App Password at: Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
