# Copy this file to .env and fill in the values

# Database (required)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/database?sslmode=require"

# Vercel Cron secret (optional)
CRON_SECRET=""

# Google OAuth — required for login
# Generate AUTH_SECRET with: openssl rand -base64 32
# Get Google credentials at: console.cloud.google.com → APIs & Services → Credentials
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Web Push (VAPID) — required for push notifications
# Generate with: npx web-push generate-vapid-keys --json
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
