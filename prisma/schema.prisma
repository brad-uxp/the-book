generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Migration convention
// ============================================================
//
// Some database objects in this project are NOT representable in the Prisma
// schema and live only in hand-written migrations. As of today:
//
//   - SubscriptionPayment_subscription_id_due_date_active_key
//     (partial unique index WHERE deleted_at IS NULL)
//   - settings_singleton_check
//     (CHECK constraint on Settings.id = 'singleton')
//
// Because `prisma migrate dev` diffs the schema against the live DB, any
// such object will appear "extra" and Prisma will try to DROP it on the
// next migration. To prevent that:
//
// 1. Always run `prisma migrate dev --create-only --name <x>` first.
// 2. Inspect the generated SQL.
// 3. Remove any `DROP INDEX`/`DROP CONSTRAINT` line that targets one of
//    the manually-managed objects above.
// 4. Then run `prisma migrate dev` to apply.
//
// Keep this list updated when new manual objects are added.

// ============================================================
// Subscriptions
// ============================================================

enum Frequency {
  monthly
  annual
}

enum Category {
  work
  personal
  essential_service
}

enum PaymentMode {
  auto
  manual
}

enum SubscriptionStatus {
  active
  inactive
}

model Subscription {
  id           String             @id @default(uuid())
  name         String
  amount_cents Int
  frequency    Frequency
  pay_day      Int // 1-31
  pay_month    Int? // 1-12, required when frequency=annual
  category     Category
  payment_mode PaymentMode
  status       SubscriptionStatus @default(active)
  notes        String?
  icon_url     String?
  created_at   DateTime           @default(now())
  updated_at   DateTime           @updatedAt

  payments SubscriptionPayment[]
}

model SubscriptionPayment {
  id                    String    @id @default(uuid())
  subscription_id       String
  due_date              DateTime
  paid_at               DateTime
  amount_cents_snapshot Int
  created_at            DateTime  @default(now())
  deleted_at            DateTime? // soft delete

  // Restrict, not Cascade: these rows ARE the accounting history. Deleting the
  // parent used to hard-delete every payment (including already soft-deleted
  // ones) and silently rewrite closed months. The API returns 409 and points
  // at the inactive status; this is the database-level backstop.
  subscription Subscription @relation(fields: [subscription_id], references: [id], onDelete: Restrict)

  // Uniqueness among non-deleted records is enforced by a partial unique index
  // (see migration partial_unique_subscription_payment). Prisma cannot model
  // partial uniques natively; the @@index below stays for queries that include
  // soft-deleted rows.
  @@index([subscription_id, due_date])
  @@index([paid_at])
}

// ============================================================
// People / Salaries
// ============================================================

enum PersonStatus {
  active
  inactive
}

enum ReminderStatus {
  scheduled
  ignored
  done
}

model Role {
  id         String   @id @default(uuid())
  name       String   @unique
  created_at DateTime @default(now())

  people Person[]
}

model Person {
  id         String       @id @default(uuid())
  name       String
  payday_day Int // 1-31
  status     PersonStatus @default(active)
  role_id    String?
  notes      String?
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  role               Role?                    @relation(fields: [role_id], references: [id])
  salary_base        SalaryBase?
  salary_payments    SalaryPayment[]
  increase_reminders SalaryIncreaseReminder[]

  @@index([role_id])
}

model SalaryBase {
  person_id         String   @id
  base_salary_cents Int
  updated_at        DateTime @updatedAt

  person Person @relation(fields: [person_id], references: [id], onDelete: Cascade)
}

model SalaryPayment {
  id                         String   @id @default(uuid())
  person_id                  String
  due_date                   DateTime
  paid_at                    DateTime
  base_salary_cents_snapshot Int
  adjustment_cents           Int      @default(0)
  adjustment_note            String?
  total_cents                Int // base_salary_cents_snapshot + adjustment_cents
  created_at                 DateTime @default(now())

  // Restrict, not Cascade — see SubscriptionPayment.subscription.
  person Person @relation(fields: [person_id], references: [id], onDelete: Restrict)

  @@unique([person_id, due_date])
  @@index([paid_at])
}

model SalaryIncreaseReminder {
  id                       String         @id @default(uuid())
  person_id                String
  effective_date           DateTime
  suggested_new_base_cents Int
  status                   ReminderStatus @default(scheduled)
  created_at               DateTime       @default(now())
  updated_at               DateTime       @updatedAt

  person Person @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@index([effective_date, status])
}

// ============================================================
// Notifications
// ============================================================

enum NotificationType {
  subscription_auto_upcoming
  subscription_manual_due
  subscription_auto_paid
  salary_manual_due
  salary_increase_due
  invoice_reminder_due
  invoice_due
  issue_due_tomorrow
  issue_due_today
}

model Notification {
  id             String           @id @default(uuid())
  type           NotificationType
  title          String
  body           String
  entity_type    String
  entity_id      String
  event_date     DateTime
  created_at     DateTime         @default(now())
  read_at        DateTime?

  @@unique([type, entity_id, event_date])
  @@index([read_at, created_at])
  @@index([created_at])
  @@index([type])
}

// ============================================================
// Push Subscriptions (Web Push)
// ============================================================

model PushSubscription {
  id         String   @id @default(uuid())
  endpoint   String   @unique
  p256dh     String
  auth       String
  user_email String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_email])
}

// ============================================================
// Settings
// ============================================================

model Settings {
  id                       String   @id @default("singleton")
  days_before_subscription Int      @default(2)
  days_before_salary       Int      @default(4)
  days_before_invoice      Int      @default(0)
  updated_at               DateTime @updatedAt
}

// ============================================================
// Other Expenses
// ============================================================

model OtherExpense {
  id           String    @id @default(uuid())
  name         String
  category     Category
  paid_at      DateTime
  amount_cents Int
  notes        String?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([paid_at])
}

// ============================================================
// Invoices
// ============================================================

enum InvoiceStatus {
  pending
  accounting
  sent
  paid
}

model Client {
  id                  String  @id @default(uuid())
  name                String
  color_hex           String  @default("#6366f1")
  default_referrer_id String?

  default_referrer Referrer? @relation(fields: [default_referrer_id], references: [id], onDelete: SetNull)
  invoices         Invoice[]
  issues           Issue[]

  @@index([default_referrer_id])
}

model Invoice {
  id             String        @id @default(uuid())
  invoice_number String?
  client_id      String
  amount_cents   Int
  fee_cents      Int           @default(0)
  status         InvoiceStatus @default(pending)
  due_date       DateTime
  reminder_date  DateTime?
  notes          String?
  file_url       String?
  file_key       String?
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  client      Client    @relation(fields: [client_id], references: [id])
  referrer_id String?
  referrer    Referrer? @relation(fields: [referrer_id], references: [id])

  @@index([due_date])
  @@index([status, due_date])
  @@index([created_at])
  @@index([client_id])
  @@index([referrer_id])
}

// ============================================================
// Referrers (intermediaries / facilitators who earn a % fee per invoice)
// ============================================================

model Referrer {
  id         String   @id @default(uuid())
  name       String
  color_hex  String   @default("#6366f1")
  created_at DateTime @default(now())

  invoices        Invoice[]
  fee_payments    FeePayment[]
  default_clients Client[]
}

// ============================================================
// Fee Payments (pass-through: recorded for visibility, excluded from net income)
// ============================================================

model FeePayment {
  id           String    @id @default(uuid())
  name         String
  paid_at      DateTime
  amount_cents Int
  notes        String?
  referrer_id  String?
  referrer     Referrer? @relation(fields: [referrer_id], references: [id])
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([paid_at])
  @@index([referrer_id])
}

// ============================================================
// Issues
// ============================================================

enum IssueStatus {
  pending
  in_progress
  blocked
  done

  @@map("TaskStatus")
}

enum IssueCategory {
  task
  note
}

model Issue {
  id          String        @id @default(uuid())
  title       String
  client_id   String?
  category    IssueCategory @default(task)
  status      IssueStatus   @default(pending)
  progress    Int           @default(0)
  due_date    DateTime?
  description String        @default("") @db.Text
  sort_order  Int           @default(0)
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt

  client Client? @relation(fields: [client_id], references: [id], onDelete: SetNull)

  @@map("Task")
  @@index([status])
  @@index([client_id])
  @@index([category])
}

// ============================================================
// Audit Logs
// ============================================================

model AuditLog {
  id          String   @id @default(uuid())
  entity_type String   // "invoice" | "subscription" | "person" | ...
  entity_id   String
  entity_name String   // denormalized label for list display (no JOIN needed)
  action      String   // "create" | "update" | "delete"
  actor_email String?  // who performed the action; null for legacy/system events
  before      Json?    // previous state (update/delete)
  after       Json?    // new state (create/update)
  created_at  DateTime @default(now())

  @@index([created_at])
  @@index([entity_type, created_at])
}

// ============================================================
// API Tokens (machine access)
// ============================================================

/**
 * Bearer credentials for non-browser clients. Deliberately separate from the
 * Google session: a leaked token is scoped to this app, revocable in one
 * click, and shows up in the audit log as itself rather than as the human.
 *
 * The secret is never stored. `token_prefix` is the readable head of the token
 * (also the lookup key, so verification is one indexed read), and `token_hash`
 * is a SHA-256 of the whole thing — the token is 256 bits of CSPRNG output, so
 * a password KDF would buy nothing against a brute force that is already
 * infeasible.
 */
model ApiToken {
  id           String    @id @default(uuid())
  name         String // human label, e.g. "claude-work-session"
  token_prefix String    @unique // first chars of the token; shown in the UI
  token_hash   String // sha256 of the full token
  created_at   DateTime  @default(now())
  last_used_at DateTime?
  expires_at   DateTime?
  revoked_at   DateTime?

  @@index([revoked_at])
}
