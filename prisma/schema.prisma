generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Subscriptions
// ============================================================

enum Frequency {
  monthly
  annual
}

enum Category {
  work
  personal
  essential_service
}

enum PaymentMode {
  auto
  manual
}

enum SubscriptionStatus {
  active
  inactive
}

model Subscription {
  id           String             @id @default(uuid())
  name         String
  amount_cents Int
  frequency    Frequency
  pay_day      Int // 1-31
  pay_month    Int? // 1-12, required when frequency=annual
  category     Category
  payment_mode PaymentMode
  status       SubscriptionStatus @default(active)
  notes        String?
  icon_url     String?
  created_at   DateTime           @default(now())
  updated_at   DateTime           @updatedAt

  payments SubscriptionPayment[]
}

model SubscriptionPayment {
  id                    String    @id @default(uuid())
  subscription_id       String
  due_date              DateTime
  paid_at               DateTime
  amount_cents_snapshot Int
  created_at            DateTime  @default(now())
  deleted_at            DateTime? // soft delete

  subscription Subscription @relation(fields: [subscription_id], references: [id], onDelete: Cascade)

  // NOTE: No DB-level unique on (subscription_id, due_date) because of soft deletes.
  // Uniqueness among non-deleted records is enforced at the application level.
  @@index([subscription_id, due_date])
  @@index([paid_at])
}

// ============================================================
// People / Salaries
// ============================================================

enum PersonStatus {
  active
  inactive
}

enum ReminderStatus {
  scheduled
  ignored
  done
}

model Role {
  id         String   @id @default(uuid())
  name       String   @unique
  created_at DateTime @default(now())

  people Person[]
}

model Person {
  id         String       @id @default(uuid())
  name       String
  payday_day Int // 1-31
  status     PersonStatus @default(active)
  role_id    String?
  notes      String?
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  role               Role?                    @relation(fields: [role_id], references: [id])
  salary_base        SalaryBase?
  salary_payments    SalaryPayment[]
  increase_reminders SalaryIncreaseReminder[]
}

model SalaryBase {
  person_id         String   @id
  base_salary_cents Int
  updated_at        DateTime @updatedAt

  person Person @relation(fields: [person_id], references: [id], onDelete: Cascade)
}

model SalaryPayment {
  id                         String   @id @default(uuid())
  person_id                  String
  due_date                   DateTime
  paid_at                    DateTime
  base_salary_cents_snapshot Int
  adjustment_cents           Int      @default(0)
  adjustment_note            String?
  total_cents                Int // base_salary_cents_snapshot + adjustment_cents
  created_at                 DateTime @default(now())

  person Person @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@unique([person_id, due_date])
  @@index([paid_at])
}

model SalaryIncreaseReminder {
  id                       String         @id @default(uuid())
  person_id                String
  effective_date           DateTime
  suggested_new_base_cents Int
  status                   ReminderStatus @default(scheduled)
  created_at               DateTime       @default(now())
  updated_at               DateTime       @updatedAt

  person Person @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@index([effective_date, status])
}

// ============================================================
// Notifications
// ============================================================

enum NotificationType {
  subscription_auto_upcoming
  subscription_manual_due
  subscription_auto_paid
  salary_manual_due
  salary_increase_due
  invoice_reminder_due
  invoice_due
  issue_due_tomorrow
  issue_due_today
}

model Notification {
  id             String           @id @default(uuid())
  type           NotificationType
  title          String
  body           String
  entity_type    String
  entity_id      String
  event_date     DateTime
  created_at     DateTime         @default(now())
  read_at        DateTime?

  @@unique([type, entity_id, event_date])
  @@index([read_at, created_at])
  @@index([created_at])
}

// ============================================================
// Push Subscriptions (Web Push)
// ============================================================

model PushSubscription {
  id         String   @id @default(uuid())
  endpoint   String   @unique
  p256dh     String
  auth       String
  user_email String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_email])
}

// ============================================================
// Settings
// ============================================================

model Settings {
  id                       String   @id @default("singleton")
  days_before_subscription Int      @default(2)
  days_before_salary       Int      @default(4)
  days_before_invoice      Int      @default(0)
  updated_at               DateTime @updatedAt
}

// ============================================================
// Other Expenses
// ============================================================

model OtherExpense {
  id           String    @id @default(uuid())
  name         String
  category     Category
  paid_at      DateTime
  amount_cents Int
  notes        String?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([paid_at])
}

// ============================================================
// Invoices
// ============================================================

enum InvoiceStatus {
  pending
  accounting
  sent
  paid
}

model Client {
  id                  String  @id @default(uuid())
  name                String
  color_hex           String  @default("#6366f1")
  default_referrer_id String?

  default_referrer Referrer? @relation(fields: [default_referrer_id], references: [id], onDelete: SetNull)
  invoices         Invoice[]
  issues           Issue[]
}

model Invoice {
  id             String        @id @default(uuid())
  invoice_number String?
  client_id      String
  amount_cents   Int
  fee_cents      Int           @default(0)
  status         InvoiceStatus @default(pending)
  due_date       DateTime
  reminder_date  DateTime?
  notes          String?
  file_url       String?
  file_key       String?
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  client      Client    @relation(fields: [client_id], references: [id])
  referrer_id String?
  referrer    Referrer? @relation(fields: [referrer_id], references: [id])

  @@index([status])
  @@index([due_date])
  @@index([status, due_date])
}

// ============================================================
// Referrers (intermediaries / facilitators who earn a % fee per invoice)
// ============================================================

model Referrer {
  id         String   @id @default(uuid())
  name       String
  color_hex  String   @default("#6366f1")
  created_at DateTime @default(now())

  invoices        Invoice[]
  fee_payments    FeePayment[]
  default_clients Client[]
}

// ============================================================
// Fee Payments (pass-through: recorded for visibility, excluded from net income)
// ============================================================

model FeePayment {
  id           String    @id @default(uuid())
  name         String
  paid_at      DateTime
  amount_cents Int
  notes        String?
  referrer_id  String?
  referrer     Referrer? @relation(fields: [referrer_id], references: [id])
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([paid_at])
}

// ============================================================
// Issues
// ============================================================

enum IssueStatus {
  pending
  in_progress
  blocked
  done

  @@map("TaskStatus")
}

enum IssueCategory {
  task
  note
}

model Issue {
  id          String        @id @default(uuid())
  title       String
  client_id   String?
  category    IssueCategory @default(task)
  status      IssueStatus   @default(pending)
  progress    Int           @default(0)
  due_date    DateTime?
  description String        @default("") @db.Text
  sort_order  Int           @default(0)
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt

  client Client? @relation(fields: [client_id], references: [id], onDelete: SetNull)

  @@map("Task")
  @@index([status])
  @@index([client_id])
  @@index([category])
}

// ============================================================
// Audit Logs
// ============================================================

model AuditLog {
  id          String   @id @default(uuid())
  entity_type String   // "invoice" | "subscription" | "person" | ...
  entity_id   String
  entity_name String   // denormalized label for list display (no JOIN needed)
  action      String   // "create" | "update" | "delete"
  before      Json?    // previous state (update/delete)
  after       Json?    // new state (create/update)
  created_at  DateTime @default(now())

  @@index([created_at])
  @@index([entity_type, created_at])
}
