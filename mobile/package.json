{
  "name": "book-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lucide-react-native": "^1.48.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "pnpm editor:build && expo start",
    "android": "pnpm editor:build && JAVA_HOME=$(/usr/libexec/java_home -v 21) expo run:android",
    "android:release": "./scripts/android-release.sh",
    "typecheck": "pnpm editor:build && tsc --noEmit",
    "lint": "pnpm editor:build && expo lint",
    "test": "node --test --experimental-strip-types src/lib/*.test.ts src/editor/*.test.ts",
    "editor:build": "node scripts/build-editor.mjs"
  },
  "private": true
}
